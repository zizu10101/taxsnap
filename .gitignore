# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# demo recordings
/scripts/record-demo/out/
/scripts/record-demo/assets/

# narrated how-to videos (generated audio/video, never committed)
/scripts/narrate/out/
scripts/narrate/**/*.wav
scripts/narrate/**/*.srt
scripts/narrate/**/*.mp4
scripts/narrate/**/*.pcm
